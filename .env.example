APP_ENV=development
APP_NAME=DataVision AI
API_HOST=0.0.0.0
API_PORT=8005
CORS_ORIGINS=http://localhost:3005
DATA_ROOT=/app/data
MAX_UPLOAD_MB=250
DATABASE_URL=postgresql+psycopg://datavision:datavision@postgres:5432/datavision
REDIS_URL=redis://redis:6379/0
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=

AUTH_SECRET=change-this-secret-before-production-32chars-minimum
CONNECTOR_SECRET_KEY=change-this-connector-secret-before-production-32chars-minimum
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
OIDC_STATE_MINUTES=10
FRONTEND_URL=http://localhost:3005
METADATA_FALLBACK_SQLITE=true
DEPLOYMENT_PROFILE=onprem
EXTERNAL_EGRESS_POLICY=explicit_opt_in


# DataVision AI Assistant / Model Gateway
DATAVISION_AI_PLANNER_MODE=deterministic
DATAVISION_AI_PRIVACY_MODE=local_only
DATAVISION_AI_ALLOW_EXTERNAL=false
DATAVISION_AI_PREFERRED_PROVIDER=
DATAVISION_AI_EXTERNAL_COLUMN_NAMES=true
DATAVISION_AI_EXTERNAL_MAX_EVENTS=5

# Optional local model provider
DATAVISION_OLLAMA_MODEL=
DATAVISION_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional OpenAI-compatible provider
DATAVISION_OPENAI_COMPATIBLE_BASE_URL=
DATAVISION_OPENAI_COMPATIBLE_MODEL=
DATAVISION_OPENAI_COMPATIBLE_API_KEY=


# Notebook sandbox
NOTEBOOK_SANDBOX_URL=http://sandbox:8090
NOTEBOOK_TIMEOUT_SECONDS=20
NOTEBOOK_MEMORY_MB=768
NOTEBOOK_MAX_CODE_CHARS=100000

# Data connector note
# SQLite connector files are restricted to DATA_ROOT/connectors/sqlite.
# Cloud connector credentials are stored in the encrypted connector secret field; do not put secrets in connector options.


# v2.31 Security P0
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DataVision AI
WEBAUTHN_ORIGIN=http://localhost:3005
MFA_POLICY=optional
MFA_CHALLENGE_MINUTES=5

# Upload malware scanning. Use required in production.
ANTIVIRUS_MODE=preferred
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8

# Dedicated AES-256-GCM envelope key. REQUIRED for APP_ENV=production.
# Use a strong random secret and rotate via SECRET_KMS_PREVIOUS_KEYS.
SECRET_KMS_KEY=
SECRET_KMS_KEY_ID=primary
SECRET_KMS_PREVIOUS_KEYS={}

# v2.58 — KMS/HSM externe via HashiCorp Vault Transit
# local conserve l'enveloppe AES-256-GCM DataVision ; vault_transit externalise les opérations cryptographiques.
SECRET_KMS_PROVIDER=local
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=datavision
VAULT_TRANSIT_HSM_BACKED=false
VAULT_TIMEOUT_SECONDS=5

# v2.58 — politiques session/appareil (valeurs par défaut si aucune politique organisationnelle n'est enregistrée)
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=336
SESSION_MAX_ACTIVE_PER_USER=10
TRUSTED_DEVICE_DAYS=30
MANAGED_DEVICE_DEFAULT_REQUIRED=false

# v2.58 — scrape interne de l'OpenTelemetry Collector. À remplacer en production.
OTEL_INTERNAL_METRICS_TOKEN=change-this-otel-metrics-token
