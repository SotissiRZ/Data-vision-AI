APP_ENV=development
APP_NAME=DataVision AI
API_HOST=0.0.0.0
API_PORT=8005
# Keep API documentation disabled on production/shared deployments.
API_DOCS_ENABLED=false
CORS_ORIGINS=http://localhost:3005
DATA_ROOT=/app/data
MAX_UPLOAD_MB=250
POSTGRES_DB=datavision
POSTGRES_USER=datavision
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg://datavision:change-this-postgres-password@postgres:5432/datavision
REDIS_URL=redis://redis:6379/0
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=

AUTH_SECRET=change-this-secret-before-production-32chars-minimum
# Authentication is mandatory by default. local_dev is development-only and MUST NOT be used in production.
AUTH_MODE=required
# First-run browser setup is automatic and local-only. Remote production servers use the server-side owner bootstrap command.
FIRST_RUN_SETUP_MODE=local
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8
PASSWORD_SCRYPT_N=131072
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
# Budget explicite pour OpenSSL scrypt (évite memory limit exceeded avec N=131072).
PASSWORD_SCRYPT_MAXMEM_MB=256

# Compte de démonstration local. Il est automatiquement désactivé en production.
DEMO_ACCOUNT_ENABLED=true
DEMO_ACCOUNT_EMAIL=demo@datavision.local
DEMO_ACCOUNT_PASSWORD=DataVision8!
DEMO_ACCOUNT_DISPLAY_NAME=Utilisateur Démo
DEMO_ACCOUNT_ORGANIZATION=DataVision Démo
# Autorise une inscription standard depuis l’écran d’authentification.
SELF_REGISTRATION_ENABLED=true
CONNECTOR_SECRET_KEY=change-this-connector-secret-before-production-32chars-minimum
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
OIDC_STATE_MINUTES=10
FRONTEND_URL=http://localhost:3005
METADATA_FALLBACK_SQLITE=true
DEPLOYMENT_PROFILE=onprem
EXTERNAL_EGRESS_POLICY=explicit_opt_in


# DataVision AI Assistant / Model Gateway
DATAVISION_AI_PLANNER_MODE=deterministic
DATAVISION_AI_PRIVACY_MODE=local_only
DATAVISION_AI_ALLOW_EXTERNAL=false
DATAVISION_AI_PREFERRED_PROVIDER=
DATAVISION_AI_EXTERNAL_COLUMN_NAMES=true
DATAVISION_AI_EXTERNAL_MAX_EVENTS=5

# Optional local model provider
DATAVISION_OLLAMA_MODEL=
DATAVISION_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional OpenAI-compatible provider
DATAVISION_OPENAI_COMPATIBLE_BASE_URL=
DATAVISION_OPENAI_COMPATIBLE_MODEL=
DATAVISION_OPENAI_COMPATIBLE_API_KEY=

# Native Anthropic Messages API
DATAVISION_ANTHROPIC_MODEL=
DATAVISION_ANTHROPIC_BASE_URL=https://api.anthropic.com
DATAVISION_ANTHROPIC_API_KEY=

# Native Google Gemini generateContent API
DATAVISION_GEMINI_MODEL=
DATAVISION_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DATAVISION_GEMINI_API_KEY=


# Notebook sandbox
NOTEBOOK_SANDBOX_URL=http://sandbox:8090
NOTEBOOK_KERNEL_MAX_SESSIONS=32
NOTEBOOK_KERNEL_TTL_SECONDS=3600
NOTEBOOK_TIMEOUT_SECONDS=20
NOTEBOOK_MEMORY_MB=768
NOTEBOOK_MAX_CODE_CHARS=100000

# Data connector note
# SQLite connector files are restricted to DATA_ROOT/connectors/sqlite.
# Cloud connector credentials are stored in the encrypted connector secret field; do not put secrets in connector options.


# v2.31 Security P0
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DataVision AI
WEBAUTHN_ORIGIN=http://localhost:3005
MFA_POLICY=optional
MFA_CHALLENGE_MINUTES=5

# Upload malware scanning. Use required in production.
ANTIVIRUS_MODE=preferred
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8

# Dedicated AES-256-GCM envelope key. REQUIRED for APP_ENV=production.
# Use a strong random secret and rotate via SECRET_KMS_PREVIOUS_KEYS.
SECRET_KMS_KEY=
SECRET_KMS_KEY_ID=primary
SECRET_KMS_PREVIOUS_KEYS={}

# v2.58 — KMS/HSM externe via HashiCorp Vault Transit
# local conserve l'enveloppe AES-256-GCM DataVision ; vault_transit externalise les opérations cryptographiques.
SECRET_KMS_PROVIDER=local
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=datavision
VAULT_TRANSIT_HSM_BACKED=false
VAULT_TIMEOUT_SECONDS=5

# v2.58 — politiques session/appareil (valeurs par défaut si aucune politique organisationnelle n'est enregistrée)
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=336
SESSION_MAX_ACTIVE_PER_USER=10
TRUSTED_DEVICE_DAYS=30
MANAGED_DEVICE_DEFAULT_REQUIRED=false

# v2.58 — scrape interne de l'OpenTelemetry Collector. À remplacer en production.
OTEL_INTERNAL_METRICS_TOKEN=change-this-otel-metrics-token

# v2.59 — migrations explicites et sauvegarde/restauration
SCHEMA_AUTO_MIGRATE=true
BACKUP_RETENTION_COUNT=7
BACKUP_REQUIRE_DATABASE_DUMP=true

# v2.60 — SRE, stockage objet et chaos contrôlé
BACKUP_OBJECT_STORE_PROVIDER=disabled
BACKUP_OBJECT_STORE_ENDPOINT=
BACKUP_OBJECT_STORE_BUCKET=
BACKUP_OBJECT_STORE_PREFIX=datavision/backups
BACKUP_OBJECT_STORE_REGION=us-east-1
BACKUP_OBJECT_STORE_ACCESS_KEY=
BACKUP_OBJECT_STORE_SECRET_KEY=
BACKUP_OBJECT_STORE_SESSION_TOKEN=
BACKUP_OBJECT_STORE_VERIFY_TLS=true
BACKUP_OBJECT_STORE_AUTO_UPLOAD=false
SRE_QUEUE_ALERT_DEPTH=25
SRE_BACKUP_MAX_AGE_HOURS=26
SRE_RESTORE_DRILL_MAX_AGE_HOURS=168
SRE_ERROR_BUDGET_BURN_ALERT=2.0
SRE_AUTO_ALERTS_ENABLED=false
SRE_CHECK_INTERVAL_SECONDS=300
SRE_WORKER_AUTOSCALING_MODE=cpu
SRE_CHAOS_ENABLED=false
SRE_CHAOS_MAX_PROBE_JOBS=20
# v2.61 SRE automatisé / continuité multi-zone
BACKUP_REPLICATION_TARGETS_JSON=[]
BACKUP_REPLICATION_AUTO_ENABLED=false
SRE_DEFAULT_ALERT_ROUTE_MIN_SEVERITY=medium
SRE_DR_ENABLED=false
SRE_DR_ALLOWED_ENVS=development,test,staging
SRE_DR_INCLUDE_DEPENDENCY_LOSS_CHECKS=true

# v2.62 — observabilité distribuée / opérations multi-cluster
# Exemple: [{"id":"cluster-a","region":"eu-west-1","role":"primary","backup_target":"zone-a"},{"id":"cluster-b","region":"eu-central-1","role":"standby","backup_target":"zone-b"}]
MULTI_CLUSTER_SITES_JSON=[]
MULTI_CLUSTER_FAILOVER_ENABLED=false
MULTI_CLUSTER_FAILOVER_EXECUTOR=control_plane_only
MULTI_CLUSTER_FAILOVER_WEBHOOK_URL=
MULTI_CLUSTER_FAILOVER_WEBHOOK_SECRET=
MULTI_CLUSTER_FAILOVER_WEBHOOK_TIMEOUT_SECONDS=10
MULTI_CLUSTER_CONFIRMATION_TTL_MINUTES=10
MULTI_CLUSTER_REQUIRE_VERIFIED_BACKUP=true
MULTI_CLUSTER_BACKUP_MAX_AGE_HOURS=26

# v2.63 operational security / rollback
SECRET_AUTO_ROTATION_ENABLED=false
SECRET_ROTATION_DEFAULT_DAYS=90
SECRET_ROTATION_GENERATED_BYTES=32
RELEASE_ROLLBACK_ENABLED=false
RELEASE_ROLLBACK_EXECUTOR=plan_only
RELEASE_ROLLBACK_WEBHOOK_URL=
RELEASE_ROLLBACK_WEBHOOK_SECRET=
RELEASE_ROLLBACK_TIMEOUT_SECONDS=10
RELEASE_ROLLBACK_CONFIRMATION_TTL_MINUTES=10

# v2.64 — admission / runtime security / continuous compliance
ADMISSION_VERIFY_IMAGES_ENABLED=false
RUNTIME_SECURITY_SECCOMP_RUNTIME_DEFAULT=true
RUNTIME_SECURITY_RUN_AS_NON_ROOT=true
RUNTIME_SECURITY_READ_ONLY_ROOT_FILESYSTEM=true
RUNTIME_SECURITY_DROP_ALL_CAPABILITIES=true
RUNTIME_SECURITY_DISALLOW_PRIVILEGE_ESCALATION=true
RUNTIME_DETECTION_ENABLED=false
CONTINUOUS_COMPLIANCE_ENABLED=false
CONTINUOUS_COMPLIANCE_SCHEDULE="23 */6 * * *"

# v2.78 — KMS cloud natif et plans produit
# SECRET_KMS_PROVIDER: local | vault_transit | aws_kms | gcp_kms | azure_key_vault
AWS_KMS_KEY_ID=
AWS_KMS_REGION=
AWS_KMS_ENDPOINT_URL=
GCP_KMS_KEY_NAME=
AZURE_KEY_VAULT_KEY_ID=
DEFAULT_PRODUCT_PLAN=entreprise
